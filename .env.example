# 复制此文件为 .env 并填入你的 DeepSeek API Key
DEEPSEEK_API_KEY=sk-你的密钥在这里
# 可选覆盖
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# 默认场景：quote_fill / reconcile / clean
# AGENTFLOW_SCENARIO=reconcile
# 单次任务 token 预算（场景配置可覆盖）
# MAX_TOTAL_TOKENS=800000
# 沙箱：设为 1 时，写操作只允许写入 data 目录内部（防止误改系统文件）
# AGENTFLOW_SANDBOX=0
